  // Timeline
  timeline: { paddingLeft: 4 },
  timelineItem: { flexDirection: 'row', marginBottom: 4 },
  timelineItemLocked: {},
  timelineLeft: { width: 44, alignItems: 'center' },
  timelineDot: {
    width: 36, height: 36, borderRadius: 18, alignItems: 'center', justifyContent: 'center',
